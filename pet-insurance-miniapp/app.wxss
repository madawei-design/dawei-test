page {
  background: #f6f7f9;
  color: #17202a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-top: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4e8ee;
  border-radius: 12rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.title {
  color: #15212f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.subtitle {
  color: #657080;
  font-size: 26rpx;
  line-height: 1.6;
}

.muted {
  color: #7c8795;
}

.row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.tag {
  background: #e7f5f2;
  border-radius: 999rpx;
  color: #0f7c6b;
  display: inline-flex;
  font-size: 22rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 16rpx;
}

.primary-btn {
  background: #0f7c6b;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-btn {
  background: #eef3f6;
  border-radius: 10rpx;
  color: #24313f;
  font-size: 28rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  color: #2b3745;
  display: block;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.input,
.picker-value {
  background: #ffffff;
  border: 1rpx solid #d9e0e8;
  border-radius: 10rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
}

.divider {
  background: #e8edf2;
  height: 1rpx;
  margin: 24rpx 0;
}
