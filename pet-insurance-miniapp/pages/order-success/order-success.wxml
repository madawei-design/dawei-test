<view class="page" wx:if="{{order}}">
  <view class="card success-card">
    <view class="success-icon">✓</view>
    <view class="title">订单提交成功</view>
    <view class="subtitle">顾问将尽快联系你确认投保信息，并协助完成支付与承保流程。</view>
  </view>

  <view class="section card">
    <view class="title block-title">订单信息</view>
    <view class="confirm-line"><text class="muted">订单号</text><text>{{order.id}}</text></view>
    <view class="confirm-line"><text class="muted">保险产品</text><text>{{order.productName}}</text></view>
    <view class="confirm-line"><text class="muted">投保人</text><text>{{order.form.ownerName}}</text></view>
    <view class="confirm-line"><text class="muted">宠物</text><text>{{order.form.petName}} · {{order.form.dogBreed}}</text></view>
    <view class="confirm-line"><text class="muted">预计年保费</text><text class="strong">¥{{order.annualPremium}}</text></view>
    <view class="confirm-line"><text class="muted">状态</text><text>{{order.status}}</text></view>
  </view>

  <view class="actions-stack">
    <button class="primary-btn" bindtap="goProfile">查看订单记录</button>
    <button class="secondary-btn" bindtap="goProducts">继续看产品</button>
  </view>
</view>
