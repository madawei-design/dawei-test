<view class="page" wx:if="{{product}}">
  <view class="card order-hero">
    <view class="title">{{product.name}}</view>
    <view class="subtitle">{{product.companyName}} · {{product.category}}</view>
    <view class="price-line">预计保费：约 ¥{{product.priceMin}}-{{product.priceMax}} / 月</view>
    <view>
      <text class="tag" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="title block-title">填写投保信息</view>

    <view class="field">
      <text class="label">投保人姓名</text>
      <input class="input" placeholder="请输入投保人姓名" value="{{form.ownerName}}" bindinput="setOwnerName" />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="用于订单确认和投保联系" value="{{form.phone}}" bindinput="setPhone" />
    </view>

    <view class="field">
      <text class="label">狗狗昵称</text>
      <input class="input" placeholder="例如：可乐" value="{{form.petName}}" bindinput="setPetName" />
    </view>

    <view class="field">
      <text class="label">犬种</text>
      <input class="input" placeholder="例如：金毛、柯基" value="{{form.dogBreed}}" bindinput="setDogBreed" />
    </view>

    <view class="field two-cols">
      <view>
        <text class="label">年龄：岁</text>
        <input class="input" type="number" placeholder="1" value="{{form.ageYear}}" bindinput="setAgeYear" />
      </view>
      <view>
        <text class="label">年龄：月</text>
        <input class="input" type="number" placeholder="0" value="{{form.ageMonth}}" bindinput="setAgeMonth" />
      </view>
    </view>

    <view class="field">
      <text class="label">所在城市</text>
      <input class="input" placeholder="例如：上海" value="{{form.city}}" bindinput="setCity" />
    </view>

    <view class="field">
      <text class="label">是否有既往病史</text>
      <radio-group class="radio-group" bindchange="setMedicalHistory">
        <label class="radio-item"><radio value="否" checked="{{form.hasMedicalHistory === '否'}}" />否</label>
        <label class="radio-item"><radio value="是" checked="{{form.hasMedicalHistory === '是'}}" />是</label>
      </radio-group>
    </view>
  </view>

  <view class="section card">
    <view class="title block-title">订单确认</view>
    <view class="confirm-line"><text class="muted">保障额度</text><text>{{product.coverageAmount}} 元</text></view>
    <view class="confirm-line"><text class="muted">免赔额</text><text>{{product.deductible}} 元</text></view>
    <view class="confirm-line"><text class="muted">等待期</text><text>{{product.waitingPeriod}} 天</text></view>
    <view class="confirm-line"><text class="muted">预计月保费</text><text class="strong">¥{{(product.priceMin + product.priceMax) / 2}}</text></view>
    <checkbox-group class="agree-box" bindchange="toggleAgree">
      <label class="agree-label"><checkbox value="agree" checked="{{form.agree}}" />我已阅读并同意投保须知与健康告知</label>
    </checkbox-group>
    <button class="primary-btn submit" bindtap="submitOrder">提交订单</button>
  </view>
</view>
