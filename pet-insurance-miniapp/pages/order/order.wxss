.order-hero {
  background: linear-gradient(135deg, #eef9f6, #ffffff);
}

.price-line {
  color: #d56a2d;
  font-size: 28rpx;
  font-weight: 700;
  margin: 18rpx 0 22rpx;
}

.two-cols {
  display: grid;
  gap: 18rpx;
  grid-template-columns: 1fr 1fr;
}

.radio-group {
  display: flex;
  gap: 30rpx;
}

.radio-item {
  align-items: center;
  color: #2b3745;
  display: inline-flex;
  gap: 10rpx;
}

.confirm-line {
  border-top: 1rpx solid #edf0f3;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.confirm-line:first-of-type {
  border-top: 0;
}

.agree-box {
  margin-top: 18rpx;
}

.agree-label {
  color: #4b5867;
  display: flex;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 24rpx;
}
