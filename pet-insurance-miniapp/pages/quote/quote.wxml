<view class="page">
  <view class="card">
    <view class="title">填写宠物信息</view>
    <view class="subtitle">用于筛选可投保产品并估算保费区间。</view>

    <view class="field">
      <text class="label">宠物类型</text>
      <picker mode="selector" range="{{petTypeLabels}}" bindchange="changePetType">
        <view class="picker-value">{{form.petTypeLabel || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">宠物昵称</text>
      <input class="input" placeholder="例如：糯米" value="{{form.petName}}" bindinput="setPetName" />
    </view>

    <view class="field two-cols">
      <view>
        <text class="label">年龄：岁</text>
        <input class="input" type="number" placeholder="0" value="{{form.ageYear}}" bindinput="setAgeYear" />
      </view>
      <view>
        <text class="label">年龄：月</text>
        <input class="input" type="number" placeholder="6" value="{{form.ageMonth}}" bindinput="setAgeMonth" />
      </view>
    </view>

    <view class="field">
      <text class="label">所在城市</text>
      <picker mode="selector" range="{{cityOptions}}" bindchange="changeCity">
        <view class="picker-value">{{form.city || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">是否有既往病史</text>
      <picker mode="selector" range="{{yesNoOptions}}" bindchange="changeMedicalHistory">
        <view class="picker-value">{{form.hasMedicalHistory || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">预算偏好</text>
      <picker mode="selector" range="{{budgetOptions}}" bindchange="changeBudget">
        <view class="picker-value">{{form.budget || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="用于顾问联系和投保提醒" value="{{form.phone}}" bindinput="setPhone" />
    </view>

    <button class="primary-btn submit" bindtap="submit">查看推荐方案</button>
  </view>
</view>
