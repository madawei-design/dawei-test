<view class="page" wx:if="{{product}}">
  <view class="card">
    <view class="title">{{product.name}}</view>
    <view class="subtitle">{{product.companyName}} · {{product.category}}</view>
    <view class="summary">{{product.summary}}</view>
    <view>
      <text class="tag" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section card" wx:if="{{isDirectOrder}}">
    <view class="title block-title">立即投保</view>
    <view class="subtitle">这款狗狗医疗险已开放小程序内下单，填写宠物和投保人信息后即可提交订单。</view>
  </view>

  <view class="section card">
    <view class="title block-title">保障概览</view>
    <view class="detail-grid">
      <view>
        <view class="muted">保障额度</view>
        <view class="strong">{{product.coverageAmount}} 元</view>
      </view>
      <view>
        <view class="muted">免赔额</view>
        <view class="strong">{{product.deductible}} 元</view>
      </view>
      <view>
        <view class="muted">等待期</view>
        <view class="strong">{{product.waitingPeriod}} 天</view>
      </view>
      <view>
        <view class="muted">价格</view>
        <view class="strong">¥{{product.priceMin}}-{{product.priceMax}}</view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="title block-title">保障亮点</view>
    <view class="list-item" wx:for="{{product.highlights}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="section card">
    <view class="title block-title">常见不保范围</view>
    <view class="list-item warn" wx:for="{{product.exclusions}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="actions" wx:if="{{!isDirectOrder}}">
    <button class="secondary-btn" bindtap="goProducts">更多产品</button>
    <button class="primary-btn" bindtap="goQuote">测算保费</button>
  </view>

  <view class="actions" wx:else>
    <button class="secondary-btn" bindtap="goProducts">更多产品</button>
    <button class="primary-btn" bindtap="goOrder">立即下单</button>
  </view>
</view>
