<view class="page">
  <view class="card order-hero">
    <view class="title">宠物上门喂养预约</view>
    <view class="subtitle">专业喂养师上门照看，喂食、换水、铲屎、陪伴一次搞定。</view>
  </view>

  <view class="section card">
    <view class="title block-title">宠物信息</view>

    <view class="field">
      <text class="label">宠物类型</text>
      <picker mode="selector" range="{{petTypeOptions}}" bindchange="changePetType">
        <view class="picker-value">{{form.petType || '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">宠物昵称</text>
      <input class="input" placeholder="例如：糯米" value="{{form.petName}}" bindinput="setPetName" />
    </view>

    <view class="field">
      <text class="label">宠物数量</text>
      <picker mode="selector" range="{{petCountOptions}}" bindchange="changePetCount">
        <view class="picker-value">{{form.petCount || '请选择'}}</view>
      </picker>
    </view>
  </view>

  <view class="section card">
    <view class="title block-title">预约时间</view>

    <view class="field">
      <text class="label">上门日期</text>
      <picker mode="date" start="{{today}}" bindchange="changeServiceDate">
        <view class="picker-value">{{form.serviceDate || '请选择日期'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">上门时间段</text>
      <picker mode="selector" range="{{timeSlotOptions}}" bindchange="changeTimeSlot">
        <view class="picker-value">{{form.timeSlot || '请选择'}}</view>
      </picker>
    </view>
  </view>

  <view class="section card">
    <view class="title block-title">联系信息</view>

    <view class="field">
      <text class="label">服务地址</text>
      <input class="input" placeholder="例如：上海市徐汇区某某小区 3 栋 502" value="{{form.address}}" bindinput="setAddress" />
    </view>

    <view class="field">
      <text class="label">联系人姓名</text>
      <input class="input" placeholder="请输入联系人姓名" value="{{form.contactName}}" bindinput="setContactName" />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="用于喂养师联系" value="{{form.phone}}" bindinput="setPhone" />
    </view>

    <view class="field">
      <text class="label">喂养要求（可选）</text>
      <textarea class="input textarea" placeholder="食量、禁忌、钥匙交接、注意事项等" value="{{form.remark}}" bindinput="setRemark" />
    </view>
  </view>

  <view class="section card">
    <checkbox-group class="agree-box" bindchange="toggleAgree">
      <label class="agree-label"><checkbox value="agree" checked="{{form.agree}}" />我已阅读并同意上门喂养服务协议</label>
    </checkbox-group>
    <button class="primary-btn submit" bindtap="submit">提交预约</button>
  </view>
</view>
