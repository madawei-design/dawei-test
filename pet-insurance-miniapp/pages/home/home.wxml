<view class="page">
  <view class="hero">
    <view class="hero-kicker">宠物医疗保障</view>
    <view class="hero-title">给狗狗配一份敢下单的医疗险</view>
    <view class="hero-copy">新增狗狗医疗险专属购买入口，支持直接填写信息并提交订单。</view>
    <view class="hero-actions">
      <button class="primary-btn hero-btn" bindtap="goDogOrder">狗狗医疗险下单</button>
      <button class="secondary-btn hero-btn secondary-hero-btn" bindtap="goQuote">先测算保费</button>
      <button class="secondary-btn hero-btn secondary-hero-btn" bindtap="goFeeding">宠物上门喂养预约</button>
    </view>
  </view>

  <view class="section grid">
    <view class="metric">
      <view class="metric-value">3万</view>
      <view class="metric-label">医疗保障</view>
    </view>
    <view class="metric">
      <view class="metric-value">20天</view>
      <view class="metric-label">等待期</view>
    </view>
    <view class="metric">
      <view class="metric-value">可下单</view>
      <view class="metric-label">狗狗专享</view>
    </view>
  </view>

  <view class="section card">
    <view class="row">
      <view>
        <view class="title small-title">热门方案</view>
        <view class="subtitle">覆盖医疗、意外和综合保障</view>
      </view>
      <button class="secondary-btn mini-btn" bindtap="goProducts">全部</button>
    </view>
    <view class="product-preview" wx:for="{{hotProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view>
        <view class="product-name">{{item.name}}</view>
        <view class="subtitle">{{item.summary}}</view>
      </view>
      <view class="price">¥{{item.priceMin}}起</view>
    </view>
  </view>

  <view class="section card">
    <view class="title small-title">推广追踪</view>
    <view class="subtitle" wx:if="{{tracking.scene}}">当前来源：{{tracking.scene}}</view>
    <view class="subtitle" wx:else>未携带渠道参数，默认记录为自然访问。</view>
  </view>
</view>
